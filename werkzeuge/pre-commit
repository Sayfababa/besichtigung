#!/bin/sh
# Git-Sperre: verhindert, dass Token oder Kundendaten ins ÖFFENTLICHE Repo gelangen.
# Wird mit  git config core.hooksPath werkzeuge  aktiviert.
fehler=0
for f in $(git diff --cached --name-only --diff-filter=ACM); do
  case "$f" in
    *.jpg|*.jpeg|*.JPG|*.heic|*.pdf|besichtigungen/*|*daten.json|*kunden.json)
      echo "GESPERRT: $f sieht nach Kundendaten aus."; fehler=1 ;;
  esac
  if git show ":$f" 2>/dev/null | grep -aEq 'github_pat_[A-Za-z0-9_]{20,}|ghp_[A-Za-z0-9]{30,}'; then
    echo "GESPERRT: $f enthaelt offenbar einen Zugriffstoken."; fehler=1
  fi
done
if [ $fehler -ne 0 ]; then
  echo "Commit abgebrochen. Diese Dateien gehoeren nicht ins oeffentliche Repo."
  exit 1
fi
exit 0
